            "x" : 0.3802055092382943,
            "y" : 0.6000903981947103
          },
          "text" : "Ina Kronenberger"
        },
        {
          "bbox" : {
            "height" : 0.020348835981428448,
            "width" : 0.2710084025065104,
            "x" : 0.39075630520682886,
